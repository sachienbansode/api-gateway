# ---------------------------------------------------------------------------
# Wrapper gateway runtime config
# Copy to .env (or /etc/api-gateway/env on the VM) and fill in.
# NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=production

# Bind loopback only; nginx terminates TLS and is the single public door.
BIND_HOST=127.0.0.1

# Trust the X-Forwarded-For from nginx (1 = one proxy hop in front of us)
TRUST_PROXY=1

# Largest request body accepted. Keep nginx client_max_body_size in step.
MAX_BODY=64kb

LOG_LEVEL=info
AUDIT_LOG=stdout

# Shown in the OpenAPI spec handed to vendors.
API_TITLE=Partner API
API_VERSION=1.0.0
PUBLIC_BASE_URL=https://partner-api.yourdomain.com


# ---------------------------------------------------------------------------
# DB 1: Gateway — the app's own database
# ---------------------------------------------------------------------------
# Holds quota counters, idempotency keys, the audit log and vendor API keys.
# Read AND written by this app. Nothing else writes to it.
#
# Keep the password OUT of the URL: GW_PG_PASSWORD is applied after the URL is
# parsed and overrides anything embedded in it. A URL gets logged, pasted into
# tickets and shown in `ps`; the password should not travel with it.
GW_DATABASE_URL=postgresql://gw_app@13.234.135.5:5432/gateway
GW_PG_PASSWORD=
GW_PG_SSL=true
GW_PG_POOL_MAX=10
# Objects live in the fixed `gateway` schema inside this database; it is not
# configurable, because the migrations and queries name it directly.

# Certificate verification. The server is self-managed Postgres, so the system
# CA store will not have its certificate. Point this at the server's own CA:
# GW_PG_CA_CERT_PATH=/etc/api-gateway/db-ca.pem
#
# Until you have that file, this encrypts without authenticating the server.
# It is a stopgap, it warns every boot, and it should not survive go-live.
GW_PG_SSL_INSECURE=true

# Migrations need DDL, which gw_app deliberately does not have. Supply the
# OWNER credential on the command line for that one command — do NOT store it
# here. A compromised gateway must not be able to DROP the audit log it was
# caught in.
#   GW_MIGRATION_DATABASE_URL=postgresql://gw_owner@13.234.135.5:5432/gateway \
#   GW_PG_PASSWORD=OWNER-PASSWORD npm run migrate
GW_MIGRATE_ON_BOOT=false

# ---------------------------------------------------------------------------
# DB 2: Auth — the platform's user and role directory
# ---------------------------------------------------------------------------
# uat_ananta_staging is PRODUCTION despite its name.
#
# READ ONLY. This app reads identity and page grants; it never writes a user,
# a role or a grant. Give this login CONNECT, USAGE on the admin schema and
# SELECT on users and roles — nothing more. A gateway compromise must not
# become a way to grant yourself a role on the platform.
#
# Postgres cannot join across databases, so this is a second pool rather than
# a second schema on DB 1. Same server, different database.
AUTH_DATABASE_URL=postgresql://gw_auth_ro@13.234.135.5:5432/uat_ananta_staging
AUTH_PG_PASSWORD=
AUTH_PG_SSL=true
AUTH_PG_POOL_MAX=5
AUTH_PG_SSL_INSECURE=true
ADMIN_SCHEMA=admin-staging-api

# Leave AUTH_DATABASE_URL blank to run on the break-glass superadmin alone.
# Admin requests then get 503 for any platform token, rather than being let in.

# ---------------------------------------------------------------------------
# Admin identity
# ---------------------------------------------------------------------------
# JWT proves identity only. Role and page grants are read live from DB 2 on
# every request behind a 15s cache, so a withdrawn grant takes effect in
# seconds rather than at token expiry.
#
# JWT_SECRET must be byte-identical to the platform's, or no token verifies.
JWT_SECRET=
JWT_ISSUER=omnenest-staging-api
GATEWAY_PAGE_KEY=api-gateway
ADMIN_PERM_CACHE_MS=15000

# Break-glass superadmin. Generate the hash with:  node scripts/gw.js admin:hash
# Works even when DB 2 is unreachable — that is its purpose. Every use is
# logged at warn. Set back to false once platform roles carry the page grant.
SUPERADMIN_ENABLED=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Vendor key cache
# ---------------------------------------------------------------------------
# Auth never queries the database on the request path — the vendor/key set is
# cached in memory and refreshed on this interval. A revocation therefore takes
# effect within this window across all instances. Lower it if you need faster
# revocation; the cost is a small query every interval.
VENDOR_CACHE_REFRESH_MS=30000


# ---------------------------------------------------------------------------
# Audit writer
# ---------------------------------------------------------------------------
# Rows are queued and flushed in batches so a slow database never adds latency
# to a vendor request. The queue is bounded: if it fills, oldest rows are
# dropped and counted rather than growing until the process dies.
AUDIT_FLUSH_MS=2000
AUDIT_BATCH_SIZE=500
AUDIT_QUEUE_MAX=5000


# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
# How long a claim is held before being treated as abandoned (a request that
# died mid-flight must not block its key forever).
IDEMPOTENCY_LEASE_MS=60000
# How long a completed response stays replayable.
IDEMPOTENCY_TTL_HOURS=24


# ---------------------------------------------------------------------------
# Field discovery — records which field paths upstreams actually return.
# Names only, never values.
# ---------------------------------------------------------------------------
DISCOVERY_FILE=/var/lib/api-gateway/discovered-fields.json


# ---------------------------------------------------------------------------
# Upstream credentials. These NEVER leave this server.
# Referenced from config/upstreams.yaml as ${ENV_VAR_NAME}.
# An unresolved reference is a hard boot failure, by design.
# ---------------------------------------------------------------------------
INTERNAL_NODE_API_TOKEN=
INTERNAL_PY_API_KEY=
THIRDPARTY_PAYMENTS_KEY=
THIRDPARTY_PAYMENTS_SECRET=
THIRDPARTY_GEO_KEY=


# ---------------------------------------------------------------------------
# Vendor API keys — ONLY used when DATABASE_URL is unset.
#
# Once the database is in play, vendors and keys live there instead:
#     node scripts/gw.js vendor:seed        # import from config/vendors.yaml
#     node scripts/gw.js key:issue acme     # issue a key
#
# For the no-database path: generate with `npm run genkey -- acme`, which prints
# the plaintext key once (give to the vendor) and the hash (put here).
# ---------------------------------------------------------------------------
# VENDOR_KEY_ACME=<sha256 hash of the key>
