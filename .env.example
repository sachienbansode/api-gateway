# ---------------------------------------------------------------------------
# Wrapper gateway runtime config
# Copy to .env (or /etc/vendor-api-wrapper/env on the VM) and fill in.
# NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=production

# Bind loopback only; nginx terminates TLS and is the single public door.
BIND_HOST=127.0.0.1

# Trust the X-Forwarded-For from nginx (1 = one proxy hop in front of us)
TRUST_PROXY=1

# Largest request body accepted. Keep nginx client_max_body_size in step.
MAX_BODY=64kb

LOG_LEVEL=info
AUDIT_LOG=stdout

# Shown in the OpenAPI spec handed to vendors.
API_TITLE=Partner API
API_VERSION=1.0.0
PUBLIC_BASE_URL=https://partner-api.yourdomain.com


# ---------------------------------------------------------------------------
# Azure Database for PostgreSQL — Flexible Server
# ---------------------------------------------------------------------------
# Leave DATABASE_URL blank to run with no database at all: the gateway still
# works, but vendor keys come from the VENDOR_KEY_* vars below, and audit
# persistence, durable quotas and idempotency are disabled. Fine for local
# development; not for production.
#
# Note: percent-encode any special characters in the password.
#
# Use the RESTRICTED role here (gw_app), never the owner or the server admin.
# See deploy/azure-postgres-setup.sql — it creates both roles — and verify with
#   node scripts/gw.js db:check
DATABASE_URL=postgresql://gw_app:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/gateway?sslmode=require

# Migrations need DDL, which gw_app deliberately does not have. Supply the OWNER
# credential only when migrating — on the command line or from your deploy
# pipeline. Do NOT store it on the gateway VM:
#   MIGRATION_DATABASE_URL=postgresql://gw_owner:PASSWORD@...:5432/gateway?sslmode=require \
#     npm run migrate

# TLS. Azure REQUIRES it. Options, best first:
#   1. Download the Azure root cert and verify against it properly:
#        curl -o /etc/vendor-api-wrapper/azure-root.pem \
#          https://dl.cacerts.digicert.com/DigiCertGlobalRootCA.crt.pem
#      then set DB_CA_CERT_PATH below.
#   2. Rely on the VM's system CA store (leave both unset).
#   3. DB_SSL_INSECURE=true — encrypted but unauthenticated. Warns every boot.
DB_SSL=require
# DB_CA_CERT_PATH=/etc/vendor-api-wrapper/azure-root.pem
# DB_SSL_INSECURE=false

# Pool sizing. A Burstable B1ms allows ~50 connections in total, so leave room
# for migrations, your admin tooling and a second gateway instance.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# Apply pending migrations automatically at boot.
# Leave this FALSE when following the two-role setup: the app role cannot do DDL,
# so a boot-time migration would fail. Run `npm run migrate` with the owner
# credential from your deploy pipeline instead.
DB_MIGRATE_ON_BOOT=false


# ---------------------------------------------------------------------------
# Vendor key cache
# ---------------------------------------------------------------------------
# Auth never queries the database on the request path — the vendor/key set is
# cached in memory and refreshed on this interval. A revocation therefore takes
# effect within this window across all instances. Lower it if you need faster
# revocation; the cost is a small query every interval.
VENDOR_CACHE_REFRESH_MS=30000


# ---------------------------------------------------------------------------
# Audit writer
# ---------------------------------------------------------------------------
# Rows are queued and flushed in batches so a slow database never adds latency
# to a vendor request. The queue is bounded: if it fills, oldest rows are
# dropped and counted rather than growing until the process dies.
AUDIT_FLUSH_MS=2000
AUDIT_BATCH_SIZE=500
AUDIT_QUEUE_MAX=5000


# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
# How long a claim is held before being treated as abandoned (a request that
# died mid-flight must not block its key forever).
IDEMPOTENCY_LEASE_MS=60000
# How long a completed response stays replayable.
IDEMPOTENCY_TTL_HOURS=24


# ---------------------------------------------------------------------------
# Field discovery — records which field paths upstreams actually return.
# Names only, never values.
# ---------------------------------------------------------------------------
DISCOVERY_FILE=/var/lib/vendor-api-wrapper/discovered-fields.json


# ---------------------------------------------------------------------------
# Upstream credentials. These NEVER leave this server.
# Referenced from config/upstreams.yaml as ${ENV_VAR_NAME}.
# An unresolved reference is a hard boot failure, by design.
# ---------------------------------------------------------------------------
INTERNAL_NODE_API_TOKEN=
INTERNAL_PY_API_KEY=
THIRDPARTY_PAYMENTS_KEY=
THIRDPARTY_PAYMENTS_SECRET=
THIRDPARTY_GEO_KEY=


# ---------------------------------------------------------------------------
# Vendor API keys — ONLY used when DATABASE_URL is unset.
#
# Once the database is in play, vendors and keys live there instead:
#     node scripts/gw.js vendor:seed        # import from config/vendors.yaml
#     node scripts/gw.js key:issue acme     # issue a key
#
# For the no-database path: generate with `npm run genkey -- acme`, which prints
# the plaintext key once (give to the vendor) and the hash (put here).
# ---------------------------------------------------------------------------
# VENDOR_KEY_ACME=<sha256 hash of the key>
