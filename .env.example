# ---------------------------------------------------------------------------
# Wrapper gateway runtime config
# Copy to .env (or /etc/api-gateway/env on the VM) and fill in.
# NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=production

# Bind loopback only; nginx terminates TLS and is the single public door.
BIND_HOST=127.0.0.1

# Trust the X-Forwarded-For from nginx (1 = one proxy hop in front of us)
TRUST_PROXY=1

# Largest request body accepted. Keep nginx client_max_body_size in step.
MAX_BODY=64kb

LOG_LEVEL=info
AUDIT_LOG=stdout

# Shown in the OpenAPI spec handed to vendors.
API_TITLE=Partner API
API_VERSION=1.0.0
PUBLIC_BASE_URL=https://partner-api.yourdomain.com


# ---------------------------------------------------------------------------
# DB 1: Gateway — the app's own database
# ---------------------------------------------------------------------------
# Holds quota counters, idempotency keys, the audit log and vendor API keys.
# Read AND written by this app. Nothing else writes to it.
#
# Keep the password OUT of the URL: GW_PG_PASSWORD is applied after the URL is
# parsed and overrides anything embedded in it. A URL gets logged, pasted into
# tickets and shown in `ps`; the password should not travel with it.
GW_DATABASE_URL=postgresql://gw_app@13.234.135.5:5432/gateway
GW_PG_PASSWORD=
GW_PG_SSL=true
GW_PG_POOL_MAX=10
# Objects live in the fixed `gateway` schema inside this database; it is not
# configurable, because the migrations and queries name it directly.

# Certificate verification. The server is self-managed Postgres, so the system
# CA store will not have its certificate. Point this at the server's own CA:
# GW_PG_CA_CERT_PATH=/etc/api-gateway/db-ca.pem
#
# Until you have that file, this encrypts without authenticating the server.
# It is a stopgap, it warns every boot, and it should not survive go-live.
GW_PG_SSL_INSECURE=true

# Migrations need DDL, which gw_app deliberately does not have. Supply the
# OWNER credential on the command line for that one command — do NOT store it
# here. A compromised gateway must not be able to DROP the audit log it was
# caught in.
#   GW_MIGRATION_DATABASE_URL=postgresql://gw_owner@13.234.135.5:5432/gateway \
#   GW_PG_PASSWORD=OWNER-PASSWORD npm run migrate
GW_MIGRATE_ON_BOOT=false

# ---------------------------------------------------------------------------
# DB 2: Auth — the platform's user and role directory
# ---------------------------------------------------------------------------
# uat_ananta_staging is PRODUCTION despite its name.
#
# READ ONLY. This app reads identity and page grants; it never writes a user,
# a role or a grant. Give this login CONNECT, USAGE on the admin schema and
# SELECT on users and roles — nothing more. A gateway compromise must not
# become a way to grant yourself a role on the platform.
#
# Postgres cannot join across databases, so this is a second pool rather than
# a second schema on DB 1. Same server, different database.
#
# The private address, not the public one: the gateway VM and the platform
# database are on the same VNet (172.31.x), so this traffic has no reason to
# leave it. Using the public IP would send every permission check out through
# the internet gateway and back.
#
# The login below is the platform's existing one. A read-only login would be
# better and the pool is written as though it had one — nothing in this
# application issues an INSERT or UPDATE against the admin schema. If a
# read-only login is ever created, only this line changes.
AUTH_DATABASE_URL=postgresql://root_admin@172.31.24.77:5432/uat_ananta_staging
AUTH_PG_PASSWORD=
AUTH_PG_SSL=false
AUTH_PG_POOL_MAX=5
ADMIN_SCHEMA=admin-staging-api

# Leave AUTH_DATABASE_URL blank to run on the break-glass superadmin alone.
# Admin requests then get 503 for any platform token, rather than being let in.
#
# Run db/platform/001_gateway_access.sql against uat_ananta_staging before
# switching SUPERADMIN_ENABLED to false, or nobody can sign in: the roles that
# carry the api-gateway grant do not exist until that file has been run.

# ---------------------------------------------------------------------------
# Admin identity
# ---------------------------------------------------------------------------
# JWT proves identity only. Role and page grants are read live from DB 2 on
# every request behind a 15s cache, so a withdrawn grant takes effect in
# seconds rather than at token expiry.
#
# JWT_SECRET signs THIS console's session cookies and is deliberately NOT the
# platform's. The two systems share accounts, not secrets: if a Pravah cookie
# is ever stolen it is useless against Ananta, and the other way round. The
# cost of that choice is that a token minted by the platform will not
# authenticate here — there is no deep-link SSO from Ananta into Pravah.
#
# Generate one that is nobody else's:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=
GATEWAY_PAGE_KEY=api-gateway
ADMIN_PERM_CACHE_MS=15000

# ---------------------------------------------------------------------------
# Second factor
# ---------------------------------------------------------------------------
# A platform role marked requires_mfa, or a user with mfa_enabled, must enter a
# six-digit code emailed to them before this console will mint a session. The
# flag is the platform's; honouring it is what stops this console from being
# the weakest way in to the same account.
#
# Same variable names as the OFS app's lib/mailer.js, deliberately: an
# operator configuring mail on a third box should not have to learn a third
# set of names.
#
# It would have been tidier to borrow the platform's SMTP settings — one mail
# configuration, rotated in one place. Don't. The platform encrypts that stored
# password under API_KEY_SECRET, and in the platform the SAME secret also
# encrypts every saved ETL database connection password and every partner API
# key. Putting it here to send an email would mean anyone who reads this file
# can decrypt all of those. OFS reached the same escape hatch for a milder
# version of the same reason.
#
# Leave SMTP_HOST blank if no role you grant uses MFA. Sign-in then fails
# closed for such a role, with a message naming the problem, rather than
# letting a password through on its own. Boot says so too.
#
# SMTP_USER may be left blank for an internal relay that accepts mail from
# this subnet without a login. SMTP_SECURE defaults from the port: 465 is
# implicit TLS, anything else is STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ashikagroup.com
SMTP_FROM_NAME=Ashika - Pravah
#
# Every code sent is written to "admin-staging-api".email_logs, so it appears
# in Admin -> Email & OTP Logs beside every other platform email (REUSE.md 3).
# The logged subject has the code stripped out of it; that table is readable by
# any platform admin.

ADMIN_OTP_TTL_MS=600000
ADMIN_OTP_MAX_ATTEMPTS=5

# Escape hatch, off by default and deliberately awkward: borrow the platform's
# mail credential instead. Requires API_KEY_SECRET here, with the consequence
# described above. Only for a deployment that already shares a trust boundary
# with the platform.
SMTP_FROM_PLATFORM=false
API_KEY_SECRET=

# Break-glass superadmin. Generate the hash with:  node scripts/gw.js admin:hash
# Works even when DB 2 is unreachable — that is its purpose. Every use is
# logged at warn.
#
# OFF is the intended steady state, and it is off here. Platform accounts are
# the way in: same people, same passwords, same deactivation, and one place to
# remove somebody when they leave. Turn it on only to recover from the platform
# database being unreachable, and turn it off again afterwards. Keep the hash
# line populated so turning it on is one word, not a scramble at 2am.
SUPERADMIN_ENABLED=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Supplier credential encryption
# ---------------------------------------------------------------------------
# Supplier tokens entered in the API Studio are sealed with AES-256-GCM and
# stored in gateway.upstream_secrets. THIS KEY IS WHAT MAKES THAT WORTH DOING:
# it lives here, not in the database, so a backup, a replica or a dump decrypts
# to nothing on its own. Never put it in a table.
#
# Generate:
#   node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
#
# Rotation: list several, newest first. New secrets use the first; old rows
# still open with whichever key they name, so re-encrypting them is a
# background job rather than an outage.
#   GW_SECRET_KEY=v2:<new 32 bytes>,v1:<old 32 bytes>
#
# BACK THIS UP somewhere other than this VM. Lose it and every stored supplier
# credential has to be re-entered by hand.
GW_SECRET_KEY=

# ---------------------------------------------------------------------------
# Vendor key cache
# ---------------------------------------------------------------------------
# Auth never queries the database on the request path — the vendor/key set is
# cached in memory and refreshed on this interval. A revocation therefore takes
# effect within this window across all instances. Lower it if you need faster
# revocation; the cost is a small query every interval.
VENDOR_CACHE_REFRESH_MS=30000


# ---------------------------------------------------------------------------
# Audit writer
# ---------------------------------------------------------------------------
# Rows are queued and flushed in batches so a slow database never adds latency
# to a vendor request. The queue is bounded: if it fills, oldest rows are
# dropped and counted rather than growing until the process dies.
AUDIT_FLUSH_MS=2000
AUDIT_BATCH_SIZE=500
AUDIT_QUEUE_MAX=5000


# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
# How long a claim is held before being treated as abandoned (a request that
# died mid-flight must not block its key forever).
IDEMPOTENCY_LEASE_MS=60000
# How long a completed response stays replayable.
IDEMPOTENCY_TTL_HOURS=24


# ---------------------------------------------------------------------------
# Field discovery — records which field paths upstreams actually return.
# Names only, never values.
# ---------------------------------------------------------------------------
DISCOVERY_FILE=/var/lib/api-gateway/discovered-fields.json


# ---------------------------------------------------------------------------
# Upstream credentials. These NEVER leave this server.
# Referenced from config/upstreams.yaml as ${ENV_VAR_NAME}.
# An unresolved reference is a hard boot failure, by design.
# ---------------------------------------------------------------------------
INTERNAL_NODE_API_TOKEN=
INTERNAL_PY_API_KEY=
THIRDPARTY_PAYMENTS_KEY=
THIRDPARTY_PAYMENTS_SECRET=
THIRDPARTY_GEO_KEY=


# ---------------------------------------------------------------------------
# Vendor API keys — ONLY used when DATABASE_URL is unset.
#
# Once the database is in play, vendors and keys live there instead:
#     node scripts/gw.js vendor:seed        # import from config/vendors.yaml
#     node scripts/gw.js key:issue acme     # issue a key
#
# For the no-database path: generate with `npm run genkey -- acme`, which prints
# the plaintext key once (give to the vendor) and the hash (put here).
# ---------------------------------------------------------------------------
# VENDOR_KEY_ACME=<sha256 hash of the key>
